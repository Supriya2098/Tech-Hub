# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# DATABASE_URL: pooled connection (pgbouncer) - used at runtime by the API
# DIRECT_URL: direct connection - used by Prisma Migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/bizpilot?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/bizpilot?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Frontend (Vite - must be prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:4000/api"
